{
  "name": "longcord",
  "version": "0.0.0",
  "description": "Control an AI coding agent running on your own computer from your phone, privately over Tailscale. Powered by Claude.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "longcord": "dist/cli/bin.js"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ansonhhlam/portable-claude.git"
  },
  "homepage": "https://github.com/ansonhhlam/portable-claude#readme",
  "bugs": {
    "url": "https://github.com/ansonhhlam/portable-claude/issues"
  },
  "keywords": [
    "agent",
    "remote",
    "phone",
    "pwa",
    "tailscale",
    "self-hosted",
    "claude",
    "agent-sdk",
    "coding-agent",
    "mobile"
  ],
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "build": "npm run build:server && npm run build:web",
    "build:server": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "dev": "npm run build && node dist/cli/bin.js start --mock --home .work/dev-data",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "licenses": "node scripts/check-licenses.mjs",
    "pack:check": "node scripts/check-pack.mjs",
    "docs:cli": "node scripts/gen-cli-docs.mjs",
    "docs:check": "node scripts/gen-cli-docs.mjs --check",
    "icons": "node scripts/gen-icons.mjs",
    "privacy-check": "node scripts/privacy-check.mjs",
    "privacy-check:history": "node scripts/privacy-check.mjs --history"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "qrcode": "^1.5.4",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.1.0",
    "dompurify": "^3.4.17",
    "eslint": "^10.14.0",
    "marked": "^18.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
